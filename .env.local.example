# 로컬 실행용 env 템플릿.
# 사용법:  cp .env.local.example .env
# 그대로 부팅된다 — 외부 연동(OAuth 로그인, 메일 발송, S3 업로드, 뉴스 수집)은 dummy 값이라
# 실제로 쓰려면 해당 키만 진짜 값으로 바꾼다. 나머지 기능(게시판, 인증 토큰, Flyway)은 이대로 동작한다.

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_OAUTH2_REDIRECT_URL=http://localhost:3000/oauth2/redirect
APP_OAUTH2_CALLBACK_BASE_URL=http://localhost:8080
APP_EMAIL_VERIFICATION_BASE_URL=http://localhost:8080

# 스키마는 Flyway가 만든다 (application.yml 기본값: flyway on + validate).
# Hibernate가 스키마를 만들던 옛 방식으로 돌아가려면 SPRING_FLYWAY_ENABLED=false + update 로 바꾼다.
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# docker-compose.local.yml 이 같은 값을 읽어 postgres 컨테이너를 만든다.
POSTGRES_DB=postforge
POSTGRES_USER=postforge
POSTGRES_PASSWORD=postforge-local
DB_POOL_MAX_SIZE=10
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM — 로컬 ollama 게이트웨이가 없어도 부팅은 된다 (호출 시점에만 필요).
LLM_PROVIDER=ollama
LLM_CHAT_BASE_URL=http://localhost:8088
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=qwen3:8b
# 임베딩은 ollama 직결이다 (ollama pull bge-m3). 키는 필요 없다.
LLM_EMBEDDING_BASE_URL=http://localhost:11434
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=bge-m3
LLM_EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=

# 메일 — 부팅에는 값만 있으면 되고 실제 발송 시점에만 검증된다.
# dummy 계정으로는 SMTP 로그인이 안 되므로 mail health check를 꺼서 /actuator/health가 UP이 되게 한다.
GMAIL_USERNAME=dummy@example.com
GMAIL_PASSWORD=dummy-mail-password
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# OAuth — ClientRegistration이 기동 시 non-empty를 요구해서 dummy가 필요하다.
# 실제 소셜 로그인 테스트 시에만 진짜 클라이언트 키로 교체.
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-secret
NAVER_CLIENT_ID=dummy-naver-client-id
NAVER_CLIENT_SECRET=dummy-naver-secret
KAKAO_CLIENT_ID=dummy-kakao-client-id
KAKAO_CLIENT_SECRET=dummy-kakao-secret

# S3 — 클라이언트 초기화만 통과하면 된다. 파일 업로드 시점에만 실검증.
AWS_REGION=ap-northeast-2
AWS_BUCKET=postforge-local-dummy
AWS_ACCESS_KEY_ID=dummy-access-key
AWS_SECRET_ACCESS_KEY=dummy-secret-key

# HS256이라 32바이트 이상이어야 한다. 로컬 전용 — prod에서는 반드시 교체.
JWT_SECRET=local-only-jwt-secret-key-postforge-0123456789abcdef0123456789

MONITORING_USERNAME=admin
MONITORING_PASSWORD=admin

# 뉴스 수집 — 기본 off. 네이버 API HUB 키를 넣고 true로 바꾸면 수집이 돈다.
NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com
NAVER_API_HUB_API_KEY_ID=
NAVER_API_HUB_API_KEY=
NAVER_NEWS_ENABLED=false
INGEST_NEWS_LAUNCH_SCHEDULER_ENABLED=false
# INGEST_NEWS_LAUNCH_CRON=0 30 * * * *
INGEST_NEWS_DIGEST_SCHEDULER_ENABLED=false
# INGEST_NEWS_DIGEST_CRON=0 0 6 * * *
