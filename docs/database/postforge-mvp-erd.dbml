Project postforge_mvp_erd {
  database_type: 'PostgreSQL'
  Note: '''
  Current code-backed PostForge MVP ERD.
  Last verified against code: 2026-06-25.
  Source of truth: docs/database/schema-ownership.md.

  Product boundary:
  auth + board community + source/ingest product collection + catalog normalization
  + price tracking + AI draft/search storage + standalone outbox.

  FK rule:
  DBML Ref entries model only actual local JPA/JDBC foreign keys.
  Cross-module scalar ids such as account_id, product_id, offer_id, and post_id are
  logical references unless the source code maps them as relations.
  '''
}

Enum account_status {
  ACTIVE
  SUSPENDED
  DELETED
}

Enum account_role {
  USER
  ADMIN
  MANAGER
}

Enum post_category {
  GENERAL
  AI_ANALYSIS
  PRODUCT_LAUNCH_NEWS
}

Enum post_board_category {
  GENERAL
  DIGITAL
  APPLIANCE
  LIVING
  HEALTH
  BEAUTY
  SPORTS
}

Enum post_publish_origin {
  USER
  SYSTEM_BATCH
  ADMIN_BACKFILL
}

Enum purchase_vote_type {
  BUYABLE
  UNSURE
  WAIT
}

Enum source_type {
  MOCK
  NAVER
}

Enum collection_job_status {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  RETRYING
  SKIPPED_BY_RATE_LIMIT
  SKIPPED_BY_CIRCUIT_OPEN
}

Enum product_status {
  ACTIVE
  HIDDEN
}

Enum product_match_status {
  PENDING
  APPROVED
  REJECTED
}

Enum outbox_status {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

Table accounts {
  id bigint [pk, increment, not null]
  username varchar(100) [not null]
  password varchar(255)
  email varchar(255) [not null]
  nickname varchar(50) [not null]
  provider varchar(30) [not null, default: 'LOCAL']
  provider_id varchar(150)
  version bigint [not null]
  status account_status [not null, default: 'ACTIVE']
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    username [unique, name: 'uk_accounts_username']
    email [unique, name: 'uk_accounts_email']
    nickname [unique, name: 'uk_accounts_nickname']
    (provider, provider_id) [unique, name: 'uk_accounts_provider_provider_id']
    status [name: 'idx_accounts_status']
  }

  Note: 'Owner: auth. Current identity table.'
}

Table account_roles {
  account_id bigint [not null]
  role account_role [not null]

  indexes {
    (account_id, role) [unique, name: 'uk_account_roles_account_role']
  }

  Note: 'Owner: auth. ElementCollection for Account.roles.'
}

Table posts {
  id bigint [pk, increment, not null]
  title varchar(100) [not null]
  content varchar(10000) [not null]
  summary varchar(500)
  category post_category [not null, default: 'GENERAL']
  board_category post_board_category [not null, default: 'GENERAL']
  publish_origin post_publish_origin [not null, default: 'USER']
  views bigint [not null, default: 0]
  like_count bigint [not null, default: 0]
  account_id bigint [not null]
  nickname varchar(50) [not null]
  created_at timestamp [not null]
  created_by varchar(100) [not null]
  modified_at timestamp [not null]
  modified_by varchar(100) [not null]

  indexes {
    created_at [name: 'idx_posts_created_at']
    account_id [name: 'idx_posts_account_id']
    category [name: 'idx_posts_category']
    board_category [name: 'idx_posts_board_category']
    publish_origin [name: 'idx_posts_publish_origin']
  }

  Note: 'Owner: board. account_id is a scalar auth reference, not a JPA relation.'
}

Table post_tags {
  post_id bigint [not null]
  tag varchar(50)

  indexes {
    post_id [name: 'idx_post_tags_post_id']
  }

  Note: 'Owner: board. ElementCollection for Post.tags.'
}

Table comments {
  id bigint [pk, increment, not null]
  post_id bigint [not null]
  content varchar(500) [not null]
  account_id bigint [not null]
  nickname varchar(50) [not null]
  parent_id bigint
  like_count bigint [not null, default: 0]
  created_at timestamp [not null]
  created_by varchar(100) [not null]
  modified_at timestamp [not null]
  modified_by varchar(100) [not null]

  indexes {
    (post_id, created_at) [name: 'idx_comments_post_created_at']
    parent_id [name: 'idx_comments_parent_id']
  }

  Note: 'Owner: board. account_id is a scalar auth reference.'
}

Table post_like {
  id bigint [pk, increment, not null]
  post_id bigint [not null]
  account_id bigint [not null]
  created_at timestamp [not null]
  created_by varchar(100) [not null]
  modified_at timestamp [not null]
  modified_by varchar(100) [not null]

  indexes {
    (post_id, account_id) [unique, name: 'uk_post_like_post_account']
    (account_id, post_id) [name: 'idx_post_like_account_post']
  }

  Note: 'Owner: board. account_id is a scalar auth reference.'
}

Table post_purchase_vote {
  id bigint [pk, increment, not null]
  post_id bigint [not null]
  account_id bigint [not null]
  vote_type purchase_vote_type [not null]
  created_at timestamp [not null]
  created_by varchar(100) [not null]
  modified_at timestamp [not null]
  modified_by varchar(100) [not null]

  indexes {
    (post_id, account_id) [unique, name: 'uk_post_purchase_vote_post_account']
    post_id [name: 'idx_post_purchase_vote_post_id']
    (account_id, post_id) [name: 'idx_post_purchase_vote_account_post']
  }

  Note: 'Owner: board. Only PRODUCT_LAUNCH_NEWS + SYSTEM_BATCH posts are vote-eligible.'
}

Table post_reference_links {
  id bigint [pk, increment, not null]
  post_id bigint [not null]
  keyword varchar(100) [not null]
  product_id bigint
  provider varchar(30) [not null]
  canonical_url varchar(1000) [not null]
  original_url varchar(1000) [not null]
  source_name varchar(100) [not null]
  published_at timestamp
  title_snapshot varchar(500) [not null]
  publish_origin post_publish_origin [not null]

  indexes {
    canonical_url [unique, name: 'uk_post_reference_links_canonical_url']
    post_id [name: 'idx_post_reference_links_post_id']
    provider [name: 'idx_post_reference_links_provider']
  }

  Note: 'Owner: board. Launch-news evidence and duplicate suppression anchor.'
}

Table comment_like {
  id bigint [pk, increment, not null]
  comment_id bigint [not null]
  account_id bigint [not null]
  created_at timestamp [not null]
  created_by varchar(100) [not null]
  modified_at timestamp [not null]
  modified_by varchar(100) [not null]

  indexes {
    (comment_id, account_id) [unique, name: 'uk_comment_like_comment_account']
    (account_id, comment_id) [name: 'idx_comment_like_account_comment']
  }

  Note: 'Owner: board. account_id is a scalar auth reference.'
}

Table post_file {
  id bigint [pk, increment, not null]
  original_file_name varchar(255) [not null]
  saved_file_name varchar(255) [not null]
  file_path varchar(500) [not null]
  file_size bigint
  file_type varchar(100) [not null]
  created_at timestamp [not null]
  post_id bigint

  indexes {
    (post_id, created_at) [name: 'idx_post_file_post_created_at']
  }

  Note: 'Owner: board. S3 object metadata.'
}

Table post_product_links {
  id bigint [pk, increment, not null]
  post_id bigint [not null]
  product_id bigint [not null]
  post_date date [not null]
  created_at timestamp [not null]

  indexes {
    post_id [unique, name: 'uk_post_product_links_post_id']
    (product_id, post_date) [unique, name: 'uk_post_product_links_product_post_date']
    product_id [name: 'idx_post_product_links_product_id']
  }

  Note: 'Owner: board. product_id is a logical catalog reference.'
}

Table tracked_keywords {
  id bigint [pk, increment, not null]
  keyword varchar(100) [not null]
  source source_type [not null]
  interval_minutes int [not null]
  display_count int [not null]
  enabled boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (source, keyword) [unique, name: 'uk_tracked_keywords_source_keyword']
  }

  Note: 'Owner: ingest. Scheduler collection target.'
}

Table collection_jobs {
  id bigint [pk, increment, not null]
  tracked_keyword_id bigint
  source source_type [not null]
  keyword varchar(100) [not null]
  status collection_job_status [not null]
  requested_at timestamp [not null]
  started_at timestamp
  finished_at timestamp
  collected_count int [not null, default: 0]
  failure_reason varchar(1000)
  retry_count int [not null, default: 0]

  Note: 'Owner: ingest. tracked_keyword_id is a logical reference.'
}

Table raw_products {
  id bigint [pk, increment, not null]
  collection_job_id bigint [not null]
  source source_type [not null]
  external_product_id varchar(120) [not null]
  raw_payload text [not null]
  collected_at timestamp [not null]

  Note: 'Owner: ingest. Provider payload snapshot.'
}

Table product_categories {
  id bigint [pk, increment, not null]
  name varchar(100) [not null, unique]
  parent_id bigint
  depth int [not null, default: 0]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: 'Owner: catalog. parent_id is a logical self reference.'
}

Table products {
  id bigint [pk, increment, not null]
  source varchar(30) [not null]
  external_product_id varchar(120) [not null]
  name varchar(200) [not null]
  normalized_name varchar(200) [not null]
  brand varchar(100)
  maker varchar(100)
  category_id bigint
  category1 varchar(100)
  category2 varchar(100)
  category3 varchar(100)
  current_price bigint [not null]
  image_url varchar(1000)
  product_url varchar(1000)
  mall_name varchar(100)
  status product_status [not null, default: 'ACTIVE']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (source, external_product_id) [unique, name: 'uk_products_source_external_id']
    normalized_name [name: 'idx_products_normalized_name']
    category_id [name: 'idx_products_category_id']
    (status, created_at) [name: 'idx_products_status_created_at']
  }

  Note: 'Owner: catalog. Normalized product truth.'
}

Table offers {
  id bigint [pk, increment, not null]
  product_id bigint [not null]
  source varchar(30) [not null]
  external_product_id varchar(120) [not null]
  mall_name varchar(100)
  title varchar(200) [not null]
  product_url varchar(1000)
  image_url varchar(1000)
  active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (source, external_product_id) [unique, name: 'uk_offers_source_external_product_id']
    product_id [name: 'idx_offers_product_id']
  }

  Note: 'Owner: catalog. Source/mall offer identity.'
}

Table product_embeddings {
  product_id bigint [pk, not null]
  embedding_input text [not null]
  embedding vector(1536) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    embedding [name: 'idx_product_embeddings_embedding']
  }

  Note: 'Owner: catalog. Created by ProductEmbeddingSchemaInitializer with HNSW cosine index.'
}

Table product_match_candidates {
  id bigint [pk, increment, not null]
  source_product_id bigint [not null]
  source varchar(30) [not null]
  external_product_id varchar(120) [not null]
  source_product_title varchar(200) [not null]
  candidate_product_id bigint [not null]
  similarity_score numeric(6,4) [not null]
  brand_matched boolean [not null]
  category_matched boolean [not null]
  status product_match_status [not null, default: 'PENDING']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (source_product_id, candidate_product_id, status) [unique, name: 'uk_product_match_candidates_source_candidate_status']
    (status, created_at) [name: 'idx_product_match_candidates_status_created']
    candidate_product_id [name: 'idx_product_match_candidates_candidate']
  }

  Note: 'Owner: catalog. Product ids are logical same-owner references.'
}

Table price_snapshots {
  id bigint [pk, increment, not null]
  product_id bigint [not null]
  offer_id bigint [not null]
  source varchar(30) [not null]
  external_product_id varchar(120) [not null]
  price bigint [not null]
  collected_at timestamp [not null]

  indexes {
    (product_id, collected_at) [name: 'idx_price_snapshots_product_collected']
    (offer_id, collected_at) [name: 'idx_price_snapshots_offer_collected']
    (source, external_product_id) [name: 'idx_price_snapshots_source_external']
  }

  Note: 'Owner: price. product_id and offer_id are logical catalog references.'
}

Table outbox_events {
  id bigint [pk, increment, not null]
  event_id varchar(36) [not null, unique]
  event_type varchar(150) [not null]
  aggregate_type varchar(80)
  aggregate_id varchar(100)
  payload text [not null]
  status outbox_status [not null, default: 'PENDING']
  retry_count int [not null, default: 0]
  available_at timestamptz [not null]
  occurred_at timestamptz [not null]
  published_at timestamptz
  last_error varchar(2000)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (status, available_at) [name: 'idx_outbox_events_status_available_at']
    (event_type, created_at) [name: 'idx_outbox_events_event_type_created_at']
    (aggregate_type, aggregate_id) [name: 'idx_outbox_events_aggregate']
  }

  Note: 'Owner: messaging. Standalone reliable event handoff table; no domain-table FK.'
}

Table vector_store {
  id uuid [pk, not null]
  content text
  metadata json
  embedding vector(1536)

  indexes {
    embedding [name: 'spring_ai_vector_index']
  }

  Note: 'Owner: ai. Spring AI PgVectorStore default table for RAG documents.'
}

Ref: account_roles.account_id > accounts.id

Ref: post_tags.post_id > posts.id
Ref: comments.post_id > posts.id
Ref: comments.parent_id > comments.id
Ref: post_like.post_id > posts.id
Ref: post_purchase_vote.post_id > posts.id
Ref: post_reference_links.post_id > posts.id
Ref: comment_like.comment_id > comments.id
Ref: post_file.post_id > posts.id
Ref: post_product_links.post_id > posts.id

Ref: raw_products.collection_job_id > collection_jobs.id

Ref: products.category_id > product_categories.id
Ref: offers.product_id > products.id

Note module_boundaries {
  '''
  source owns external API clients and has no relational table in the current schema.
  ingest owns collection orchestration and raw provider payloads.
  catalog owns normalized product truth and product matching.
  price owns price snapshot history and response-only price judgement.
  board owns posts, interactions, purchase votes, reference links, file metadata, and post/product links.
  ai owns vector_store; catalog owns product_embeddings.
  '''
}
