# 필수. 비워두면 기동에 실패한다(의도적 — 배포 서버에서 누락을 조용히 넘기지 않기 위함)
# 끝에 / 를 붙이지 않는다. 경로는 애플리케이션이 붙인다.
APP_FRONTEND_BASE_URL=
APP_API_BASE_URL=
# 여러 origin이 필요할 때만 지정(미지정 시 APP_FRONTEND_BASE_URL 사용)
# APP_CORS_ALLOWED_ORIGINS=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_POOL_MAX_SIZE=10
REDIS_HOST=
REDIS_PORT=

# LLM — prod에서는 채팅·임베딩 주소와 모델명이 필수다. 두 주소 모두 게이트웨이(예: http://10.0.0.1:8088)를 사용한다.
# 앱 컨테이너에서 접근 가능한 주소를 입력한다. localhost는 컨테이너 자신이다.
LLM_CHAT_BASE_URL=
LLM_CHAT_MODEL=qwen3:8b
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=bge-m3
# 게이트웨이 공용 토큰은 채팅·임베딩에 적용된다. 개별 API_KEY 설정이 우선한다.
LLM_GATEWAY_TOKEN=
# LLM_CHAT_API_KEY=
# LLM_EMBEDDING_API_KEY=
# OPENAI_API_KEY=
# 임베딩 기본 차원은 1024다. 모델을 바꾸면 스키마 호환성과 재적재 여부를 확인한다.

GMAIL_USERNAME=
GMAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

JWT_SECRET=

MONITORING_USERNAME=
MONITORING_PASSWORD=

NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com
NAVER_API_HUB_API_KEY_ID=
NAVER_API_HUB_API_KEY=
NAVER_API_HUB_CONNECT_TIMEOUT=3s
NAVER_API_HUB_READ_TIMEOUT=10s
NAVER_NEWS_ENABLED=false
INGEST_NEWS_LAUNCH_SCHEDULER_ENABLED=false
# INGEST_NEWS_LAUNCH_CRON=0 30 * * * *
INGEST_NEWS_DIGEST_SCHEDULER_ENABLED=false
# INGEST_NEWS_DIGEST_CRON=0 0 6 * * *
