# 필수. 비워두면 기동에 실패한다(의도적 — 배포 서버에서 누락을 조용히 넘기지 않기 위함)
# 끝에 / 를 붙이지 않는다. 경로는 애플리케이션이 붙인다.
APP_FRONTEND_BASE_URL=
APP_API_BASE_URL=
# 여러 origin이 필요할 때만 지정(미지정 시 APP_FRONTEND_BASE_URL 사용)
# APP_CORS_ALLOWED_ORIGINS=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_POOL_MAX_SIZE=10
REDIS_HOST=
REDIS_PORT=

LLM_PROVIDER=ollama
LLM_CHAT_BASE_URL=http://localhost:8088
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=qwen3:8b
LLM_CHAT_CONNECT_TIMEOUT=3s
LLM_CHAT_READ_TIMEOUT=60s
# prod(application-prod.yml)는 CHAT/EMBEDDING의 BASE_URL과 MODEL에 기본값이 없어 env가 필수다.
# 임베딩 provider는 env로 교체한다. vector_store 컬럼이 1024차원이라
# 어떤 provider를 쓰든 1024를 내야 하고, DIMENSIONS 값이 요청에 함께 실린다.
#   로컬(기본): ollama + bge-m3  ->  ollama pull bge-m3
#   상용 전환:  BASE_URL=https://api.openai.com, MODEL=text-embedding-3-small, API_KEY=<키>
#   text-embedding-3-small/large는 dimensions로 1024를 맞출 수 있다. ada-002는 1536 고정이라 쓸 수 없다.
#   provider를 바꾸면 벡터 공간이 달라지므로 기존 문서는 재적재해야 한다.
LLM_EMBEDDING_BASE_URL=http://localhost:11434
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=bge-m3
LLM_EMBEDDING_DIMENSIONS=1024
LLM_EMBEDDING_CONNECT_TIMEOUT=3s
LLM_EMBEDDING_READ_TIMEOUT=30s

OPENAI_API_KEY=

GMAIL_USERNAME=
GMAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

JWT_SECRET=

MONITORING_USERNAME=
MONITORING_PASSWORD=

NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com
NAVER_API_HUB_API_KEY_ID=
NAVER_API_HUB_API_KEY=
NAVER_API_HUB_CONNECT_TIMEOUT=3s
NAVER_API_HUB_READ_TIMEOUT=10s
NAVER_NEWS_ENABLED=false
INGEST_NEWS_LAUNCH_SCHEDULER_ENABLED=false
# INGEST_NEWS_LAUNCH_CRON=0 30 * * * *
INGEST_NEWS_DIGEST_SCHEDULER_ENABLED=false
# INGEST_NEWS_DIGEST_CRON=0 0 6 * * *
